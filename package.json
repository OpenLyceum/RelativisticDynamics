{
  "name": "relativistic-dynamics",
  "version": "0.0.0",
  "private": true,
  "description": "Relativistic dynamics in four screens: a particle pushed toward c against Newton's prediction and Bertozzi's 1964 data, the energy–momentum triangle and mass shell seen by moving observers, two-body collisions viewed from any frame, and threshold energies for fixed-target and collider reactions.",
  "keywords": [
    "simulation",
    "SceneryStack",
    "interactive",
    "physics",
    "special relativity",
    "relativistic momentum",
    "four-vector",
    "collisions",
    "threshold energy",
    "education",
    "pwa"
  ],
  "homepage": "https://openlyceum.github.io/RelativisticDynamics",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenLyceum/RelativisticDynamics.git"
  },
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "build:single": "tsc && vite build --mode single",
    "check": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "check:architecture": "depcruise src",
    "check:unused": "knip",
    "clean": "rm -rf dist",
    "dev": "vite",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "icons": "node scripts/generate-icons.ts",
    "knip": "knip",
    "lint": "biome check --error-on-warnings .",
    "prepare": "test \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$PWD\" && git config core.hooksPath .githooks || true",
    "preview": "vite preview",
    "release": "npm run check && npm run lint && npm run check:architecture && npm run build && npm test && npm version patch && git push && git push --tags",
    "start": "vite",
    "test": "vitest run",
    "test:architecture": "node --test tests/*.node-test.ts",
    "test:fuzz": "node scripts/test-fuzz.ts",
    "test:fuzz:long": "node scripts/test-fuzz.ts 300",
    "test:fuzz:quick": "node scripts/test-fuzz.ts 10",
    "test:soak": "npm run test:soak:headless && npm run test:soak:browser",
    "test:soak:browser": "npx playwright test tests/soak/browser.spec.ts",
    "test:soak:headless": "vitest run --config vitest.soak.config.ts",
    "test:watch": "vitest",
    "watch": "tsc --watch"
  },
  "overrides": {
    "brace-expansion": "~5.0.12",
    "lodash": "~4.18.1",
    "three": "~0.125.2"
  },
  "dependencies": {
    "scenerystack": "^3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@swc/core": "^1.15.3",
    "@types/node": "^26.6.6",
    "dependency-cruiser": "^18.8.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.46.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "@swc/core@1.16.22": true
  }
}
